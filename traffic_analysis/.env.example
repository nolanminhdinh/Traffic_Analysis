# ==============================================================================
# TRAFFIC ANALYSIS PIPELINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env (cp .env.example .env) và điền các giá trị thực tế.
# Lưu ý: Không commit file .env chứa mật khẩu thực tế lên Git repository.

# ------------------------------------------------------------------------------
# 1. API Gateway (Flask)
# ------------------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# ------------------------------------------------------------------------------
# 2. Apache Kafka
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_GPS=gps_stream_topic
KAFKA_GROUP_ID=ingestion_worker_v1

# ------------------------------------------------------------------------------
# 3. Object Storage Data Lake (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=traffic-lake
MINIO_REGION=us-east-1

# ------------------------------------------------------------------------------
# 4. Local Database (PostgreSQL / TimescaleDB via Docker)
# ------------------------------------------------------------------------------
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=traffic_analytics
LOCAL_DB_USER=admin
LOCAL_DB_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 5. Cloud Database (Neon Serverless PostgreSQL - Production)
# ------------------------------------------------------------------------------
CLOUD_DB_HOST=ep-old-voice-a1mw52bq-pooler.ap-southeast-1.aws.neon.tech
CLOUD_DB_PORT=5432
CLOUD_DB_NAME=neondb
CLOUD_DB_USER=neondb_owner
CLOUD_DB_PASSWORD=npg_MQb4CymvOSs5
CLOUD_DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 6. Pipeline & Analytics Hyperparameters
# ------------------------------------------------------------------------------
ETL_INTERVAL_SEC=60
INGESTION_BATCH_SIZE=100
SPEED_CONGESTED_KMH=10.0
SPEED_SLOW_KMH=25.0
INEFFICIENT_SPEED_THRESHOLD=5.0
INEFFICIENT_VEHICLE_MIN_COUNT=3
